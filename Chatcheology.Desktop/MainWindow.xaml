<Window x:Class="Chatcheology.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Chatcheology.Desktop"
        xmlns:vm="clr-namespace:Chatcheology.Desktop.ViewModels"
        xmlns:controls="clr-namespace:Chatcheology.Desktop.Controls"
        mc:Ignorable="d"
        Title="Chatcheology" Icon="Resources/app.ico" Height="720" Width="1000"
        Background="#FFF4F2EE">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- A validation message next to its field (CH-42 step 4); takes no room when empty. -->
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF8A2727" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One attachment, in exactly one of its three states.

             Unresolved is the archive's ordinary state and is coloured as a neutral note, never as
             a warning: an attachment nobody has matched is not a fault, and colouring hundreds of
             them as problems would report the project's own caution as damage.

             A resolved attachment whose file is not reachable is styled as resolved, because it
             is not an unresolved one.

             An unresolved attachment a review recorded as insufficient evidence is "media
             missing": muted, with a dashed outline (a Border cannot dash, so a Rectangle overlays
             it), so it stands apart from slots nobody has looked at yet. -->
        <DataTemplate x:Key="AttachmentTemplate" DataType="{x:Type vm:AttachmentViewModel}">
            <!-- A WhatsApp low-quality copy (CH-10) is collapsed unless the toolbar toggle shows
                 copies. Collapsing is presentation only; its Phase 7 state is untouched. -->
            <!-- CH-71: the picture's caption sits under the card, outside it, so a click on one of its
                 links never opens the review panel. Shown whatever the state: it is the sender's text. -->
            <StackPanel Margin="0,6,0,0"
                        Visibility="{Binding IsShown, Converter={StaticResource BoolToVisibility}}">
            <Grid>
            <Border Padding="8" CornerRadius="4" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#FFB8B2A8" />
                        <Setter Property="Background" Value="#FFEDE9E2" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUnresolved}" Value="True">
                                <Setter Property="BorderBrush" Value="#FFC7CDD4" />
                                <Setter Property="Background" Value="#FFF3F5F8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsResolvedAndUnavailable}" Value="True">
                                <Setter Property="BorderBrush" Value="#FF8A8A8A" />
                                <Setter Property="Background" Value="#FFE8E8E8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsReviewedMissing}" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Background" Value="#FFF4F1EC" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel Background="Transparent"
                            MouseLeftButtonUp="AttachmentCardClick"
                            ToolTip="Open the review panel for this attachment">
                    <TextBlock Text="Low-quality copy" FontSize="10" Foreground="#FF7A6A2E"
                               Margin="0,0,0,2"
                               Visibility="{Binding HasLowQualityCopyLabel,
                                   Converter={StaticResource BoolToVisibility}}" />

                    <!-- With details off (CH-20) the headline goes only when a preview is
                         shown; the asset facts, the detail sentence and the file name always go.
                         The preview, Open media, its error and the copy label and note stay. -->
                    <TextBlock Text="{Binding HeadlineText}" FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsHeadlineShown,
                                   Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding AssetText}" Margin="0,2,0,0" Foreground="#FF3C3C3C"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsAssetTextShown,
                                   Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding DetailText}" Margin="0,2,0,0" FontSize="11"
                               Foreground="#FF5A5A5A" TextWrapping="Wrap"
                               Visibility="{Binding AreDetailsShown,
                                   Converter={StaticResource BoolToVisibility}}" />

                    <Image Source="{Binding Thumbnail}" Margin="0,6,0,0"
                           MaxWidth="320" MaxHeight="320"
                           HorizontalAlignment="Left" Stretch="Uniform"
                           Visibility="{Binding HasThumbnail,
                               Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding FileName}" Margin="0,4,0,0" FontSize="11"
                               Foreground="#FF5A5A5A" TextWrapping="Wrap"
                               Visibility="{Binding IsFileNameShown,
                                   Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="Open media" Margin="0,4,0,0" Padding="8,2"
                            HorizontalAlignment="Left"
                            Click="OpenMediaClick"
                            Visibility="{Binding CanOpenExternally,
                                Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding OpenError}" Margin="0,4,0,0" FontSize="11"
                               Foreground="#FF8A2727" TextWrapping="Wrap" />

                    <TextBlock Text="{Binding LowQualityCopyNoteText}" Margin="0,4,0,0"
                               FontSize="10" Foreground="#FF7A7A7A" TextWrapping="Wrap"
                               Visibility="{Binding HasLowQualityCopyNote,
                                   Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Rectangle RadiusX="4" RadiusY="4" StrokeThickness="1.5"
                       Stroke="#FF8C8478" StrokeDashArray="4 3" IsHitTestVisible="False"
                       Visibility="{Binding IsReviewedMissing,
                           Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <TextBlock Margin="2,4,0,0" MaxWidth="336" HorizontalAlignment="Left" TextWrapping="Wrap"
                       controls:LinkedText.Spans="{Binding CaptionSpans}"
                       Visibility="{Binding HasCaption,
                           Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <!-- One candidate. Every current candidate appears, including one already disproven and
             one whose media this machine cannot reach: a list that quietly shrank would let "one
             left" start to look like an answer. Nothing here is worded as a recommendation. -->
        <DataTemplate x:Key="CandidateTemplate" DataType="{x:Type vm:CandidateViewModel}">
            <Border Margin="0,0,0,6" Padding="8" CornerRadius="4" BorderThickness="1"
                    BorderBrush="#FFC7CDD4" Background="#FFFBFCFD">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIndependentlyDisproven}" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Background" Value="#FFF0F0F0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock Text="Independently disproven" FontWeight="SemiBold" FontSize="11"
                               Foreground="#FF7A5A2E" Margin="0,0,0,3"
                               Visibility="{Binding IsIndependentlyDisproven,
                                   Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding AssetText}" FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{Binding TierText}" Margin="0,2,0,0" FontSize="11"
                               Foreground="#FF5A5A5A" TextWrapping="Wrap" />

                    <TextBlock Text="{Binding SupportText}" FontSize="11"
                               Foreground="#FF5A5A5A" TextWrapping="Wrap" />

                    <Border Margin="0,6,0,0" Padding="4" CornerRadius="3"
                            BorderBrush="#FFD8CFA8" BorderThickness="1" Background="#FFFDFBF0"
                            HorizontalAlignment="Left"
                            Visibility="{Binding HasThumbnail,
                                Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Candidate media — not reconstructed media"
                                       FontSize="10" Foreground="#FF7A6A2E" Margin="0,0,0,3" />
                            <Image Source="{Binding Thumbnail}" MaxWidth="260" MaxHeight="260"
                                   HorizontalAlignment="Left" Stretch="Uniform" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding MediaStateText}" Margin="0,4,0,0" FontSize="11"
                               Foreground="#FF7A7A7A" TextWrapping="Wrap" />

                    <TextBlock Text="{Binding FileName}" Margin="0,4,0,0" FontSize="11"
                               Foreground="#FF5A5A5A" TextWrapping="Wrap"
                               Visibility="{Binding HasAvailableCopy,
                                   Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="Open candidate media" Margin="0,4,0,0" Padding="8,2"
                            HorizontalAlignment="Left" Click="OpenCandidateMediaClick"
                            Visibility="{Binding CanOpenExternally,
                                Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One resolution-history entry, in Phase 7 event order. -->
        <DataTemplate x:Key="HistoryTemplate" DataType="{x:Type vm:ResolutionEventViewModel}">
            <Border Margin="0,0,0,4" Padding="6" CornerRadius="3"
                    BorderBrush="#FFDAD5CC" BorderThickness="1" Background="White">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding HeadlineText}" FontWeight="SemiBold"
                                   DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding OccurredText}" FontSize="11"
                                   Foreground="#FF7A7A7A" DockPanel.Dock="Right" />
                    </DockPanel>
                    <TextBlock Text="{Binding DetailText}" Margin="0,2,0,0" FontSize="11"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TechnicalText}" Margin="0,2,0,0" FontSize="10"
                               Foreground="#FF9A9A9A" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One message. The date separator is a property of the message rather than a grouping,
             because WPF grouping switches container virtualisation off. -->
        <DataTemplate DataType="{x:Type vm:MessageViewModel}">
            <StackPanel>
                <Border Margin="0,12,0,8" Padding="10,3" CornerRadius="9"
                        Background="#FFDDD7CC" HorizontalAlignment="Center"
                        Visibility="{Binding HasDateSeparator,
                            Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding DateSeparatorText}" FontSize="11"
                               Foreground="#FF3C3C3C" />
                </Border>

                <Border MaxWidth="620" Margin="8,2" Padding="10,7" CornerRadius="6"
                        Background="White" BorderBrush="#FFDAD5CC" BorderThickness="1"
                        HorizontalAlignment="{Binding BubbleAlignment}"
                        Visibility="{Binding IsShown, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="{Binding SenderText}" FontWeight="SemiBold"
                                       Foreground="{Binding SenderBrush}"
                                       DockPanel.Dock="Left" />

                            <TextBlock Text="{Binding TimeText}" Margin="16,0,0,0" FontSize="11"
                                       Foreground="#FF7A7A7A" DockPanel.Dock="Right" />
                        </DockPanel>

                        <!-- WhatsApp's own forwarded wording, from the msgstore (CH-8). -->
                        <TextBlock Text="{Binding ForwardedText}" Margin="0,2,0,0" FontSize="11"
                                   FontStyle="Italic" Foreground="#FF7A7A7A"
                                   Visibility="{Binding HasForwardedLabel,
                                       Converter={StaticResource BoolToVisibility}}" />

                        <!-- Inlines rather than Text, so web and email addresses are followable.
                             Displaying one contacts nothing; a link is only followed on a click. -->
                        <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"
                                   controls:LinkedText.Spans="{Binding TextSpans}"
                                   Visibility="{Binding HasMessageText,
                                       Converter={StaticResource BoolToVisibility}}" />

                        <ItemsControl ItemsSource="{Binding Attachments}"
                                      ItemTemplate="{StaticResource AttachmentTemplate}"
                                      Visibility="{Binding HasAttachments,
                                          Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- A memory row (CH-42 step 5): never a message. Centred, lilac and framed, unlike bubbles
             and the date separator; the content and wording are the phone's own rows. A click opens
             the memory's details; it selects no message and leaves the review panel alone. -->
        <Style x:Key="MemoryCardFrame" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FF6A4C9C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFF1ECFA" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Show this memory's details" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderThickness" Value="2.5" />
                    <Setter Property="Background" Value="#FFE4DAF5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The muted "different times" line keeps its plain look; selected, it is tinted. -->
        <Style x:Key="MemoryLineFrame" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Show this memory's details" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#FFE4DAF5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Gallery links (CH-48): shared by the memory form and the noted-date form. -->
        <DataTemplate DataType="{x:Type vm:GalleryLinksEditor}">
            <StackPanel Margin="0,2,0,0">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#FFDDD7CC" BorderThickness="1" Padding="6" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Heading}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="Address (https://…)" FontSize="11" Margin="0,2,0,0" />
                                    <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding UrlError}" Style="{StaticResource FieldError}" />
                                    <TextBlock Text="Label (optional, up to 60 characters)" FontSize="11" Margin="0,4,0,0" />
                                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding LabelError}" Style="{StaticResource FieldError}" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="Up" Padding="6,0" Margin="0,0,4,0" Command="{Binding MoveUpCommand}" />
                                        <Button Content="Down" Padding="6,0" Margin="0,0,4,0" Command="{Binding MoveDownCommand}" />
                                        <Button Content="Remove" Padding="6,0" Command="{Binding RemoveCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Content="Add link" Padding="8,2" Command="{Binding AddCommand}" />
                    <TextBlock Text="{Binding CountText, Mode=OneWay}" FontSize="11" Foreground="#FF5A5A5A"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding ListError}" Style="{StaticResource FieldError}" />
                <TextBlock Text="{Binding NoticeText, Mode=OneWay}" FontSize="10" Foreground="#FF7A7A7A"
                           TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MemoryRowViewModel}">
            <StackPanel>
                <Border Margin="0,12,0,8" Padding="10,3" CornerRadius="9"
                        Background="#FFDDD7CC" HorizontalAlignment="Center"
                        Visibility="{Binding HasDateSeparator,
                            Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding DateSeparatorText}" FontSize="11"
                               Foreground="#FF3C3C3C" />
                </Border>

                <!-- A PSN period card. -->
                <Border Style="{StaticResource MemoryCardFrame}" MaxWidth="420" Margin="40,6" Padding="10,8"
                        MouseLeftButtonUp="MemoryRowClick"
                        Visibility="{Binding IsPeriodCard, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Image Source="{Binding Image}" Width="56" Height="56" Margin="0,0,10,0"
                               VerticalAlignment="Top" Stretch="Uniform" DockPanel.Dock="Left"
                               Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="#FF6A6A6A" />
                            <ItemsControl ItemsSource="{Binding Lines}" Margin="0,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding LabelText}" FontSize="11" Foreground="#FF6A4C9C"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding SourceText}" FontSize="10" Foreground="#FF6A6A6A"
                                       Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- A personal memory at its start (a range shows one card). -->
                <Border Style="{StaticResource MemoryCardFrame}" Width="300" Margin="40,6" Padding="0,0,0,8"
                        MouseLeftButtonUp="MemoryRowClick"
                        Visibility="{Binding IsEntryCard, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="{Binding Image}" MaxHeight="170" Stretch="Uniform" />
                            <!-- "+4": the memory's extra photos after the cover (CH-46). -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                    Padding="6,1" CornerRadius="8" Background="#CC000000"
                                    Visibility="{Binding HasExtraPhotos, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ExtraPhotosBadge}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="White" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding CollectionName}" FontSize="10" Foreground="#FF6A4C9C"
                                   Margin="10,6,10,0" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="10,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="#FF6A6A6A"
                                   Margin="10,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Summary}" FontSize="12" Margin="10,2,10,0"
                                   TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding SourceText}" FontSize="10" Foreground="#FF6A6A6A"
                                   Margin="10,2,10,0"
                                   Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- The muted "different times" line: not a claim of simultaneous play. -->
                <Border Style="{StaticResource MemoryLineFrame}" MaxWidth="460" Margin="40,2" Padding="8,2"
                        MouseLeftButtonUp="MemoryRowClick"
                        Visibility="{Binding IsDifferentTimes, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Text}" FontSize="11" FontStyle="Italic" Foreground="#FF6A6A6A"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- One trophy in the memory details: icon, name (or "Bronze trophy #12"), time and whose. -->
        <DataTemplate x:Key="MemoryItemTemplate" DataType="{x:Type vm:MemoryItemViewModel}">
            <DockPanel Margin="0,3">
                <Image Source="{Binding Icon}" Width="36" Height="36" Margin="0,0,8,0"
                       VerticalAlignment="Top" DockPanel.Dock="Left"
                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="#FF6A6A6A" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- The window's content, with the large view of a memory's photo over it (CH-46). The DockPanel
         below keeps its earlier indentation so the history of its contents stays readable. -->
    <Grid>
    <DockPanel>

        <!-- Toolbar. A WrapPanel, so items that do not fit the window's width move to a second
             row instead of being clipped off the right edge (CH-18: the archive buttons are last). -->
        <Border DockPanel.Dock="Top" Background="#FFE7E2D9" BorderBrush="#FFCFC8BC"
                BorderThickness="0,0,0,1" Padding="8,6">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Chatcheology" FontWeight="Bold" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,16,0" DockPanel.Dock="Left" />

                <Button Content="Open Workspace…" Padding="10,3" Margin="0,0,12,0"
                        Command="{Binding OpenWorkspaceCommand}" DockPanel.Dock="Left" />

                <TextBlock Text="Conversation" VerticalAlignment="Center" Margin="0,0,6,0"
                           DockPanel.Dock="Left" />

                <ComboBox Width="200" Margin="0,0,16,0" DockPanel.Dock="Left"
                          ItemsSource="{Binding Conversations}"
                          SelectedItem="{Binding SelectedConversation}"
                          IsEnabled="{Binding CanChangeConversation}"
                          DisplayMemberPath="Title" />

                <TextBlock Text="Show as" VerticalAlignment="Center" Margin="0,0,6,0"
                           DockPanel.Dock="Left" />

                <ComboBox Width="150" Margin="0,0,16,0" DockPanel.Dock="Left"
                          ItemsSource="{Binding Participants}"
                          SelectedItem="{Binding LocalParticipant}"
                          DisplayMemberPath="DisplayName"
                          ToolTip="Session only. Nothing is written to the workspace." />

                <DatePicker Width="130" Margin="0,0,6,0" DockPanel.Dock="Left"
                            SelectedDate="{Binding JumpDate}" />

                <Button Content="Jump to date" Padding="10,3" DockPanel.Dock="Left"
                        Command="{Binding JumpToDateCommand}" />

                <!-- Offered only when the workspace records a low-quality copy (CH-10). -->
                <CheckBox x:Name="ShowLowQualityCopiesToggle" Content="Show low-quality copies"
                          Margin="16,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left"
                          IsChecked="{Binding ShowLowQualityCopies}"
                          ToolTip="Session only. Nothing is written to the workspace."
                          Visibility="{Binding HasLowQualityCopies,
                              Converter={StaticResource BoolToVisibility}}" />

                <!-- Card details (CH-20). Offered whenever a conversation is open; off by default,
                     and toggling it redraws the cards without moving the page. -->
                <CheckBox x:Name="ShowDetailsToggle" Content="Show details"
                          Margin="16,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left"
                          IsChecked="{Binding ShowDetails}"
                          ToolTip="Session only. Nothing is written to the workspace.">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedConversation}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <!-- Portable archive (CH-18). Export takes the selected conversation; Validate
                     checks any archive folder, and compares it when a conversation is open. -->
                <Button Content="Export archive…" Padding="10,3" Margin="16,0,0,0"
                        DockPanel.Dock="Left" Command="{Binding ExportArchiveCommand}"
                        ToolTip="Export the selected conversation to a new archive folder." />

                <Button Content="Validate archive…" Padding="10,3" Margin="8,0,0,0"
                        DockPanel.Dock="Left" Command="{Binding ValidateArchiveCommand}"
                        ToolTip="Check an archive folder. Nothing is written." />

                <!-- Personal memories (CH-42 step 4), in the memories file beside the workspace. -->
                <Button Content="Memories…" Padding="10,3" Margin="16,0,0,0"
                        DockPanel.Dock="Left" Command="{Binding Memories.OpenCommand}"
                        ToolTip="Add and edit your own memories. The workspace is not changed." />
            </WrapPanel>
        </Border>

        <!-- Archive panel: progress while an export or check runs, then its summary. Counts and
             check outcomes only; never message text, names or paths. -->
        <Border DockPanel.Dock="Top" Background="#FFF7F6F3" BorderBrush="#FFCFC8BC"
                BorderThickness="0,0,0,1" Padding="10,8"
                Visibility="{Binding Archive.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <!-- Cancel is shown only while the export can still be stopped; the checks, and the
                     moments after Cancel was pressed, offer no button that would do nothing. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Cancel export" Padding="10,3" Margin="8,0,0,0"
                            Command="{Binding Archive.CancelCommand}"
                            Visibility="{Binding Archive.CanCancel,
                                Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Open folder" Padding="10,3" Margin="8,0,0,0"
                            Command="{Binding Archive.OpenFolderCommand}"
                            Visibility="{Binding Archive.CanOpenFolder,
                                Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Close" Padding="10,3" Margin="8,0,0,0"
                            Command="{Binding Archive.CloseCommand}"
                            Visibility="{Binding Archive.IsFinished,
                                Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="{Binding Archive.HeadlineText}" FontWeight="SemiBold"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FF3C3C3C" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Archive.Outcome}" Value="Passed">
                                        <Setter Property="Foreground" Value="#FF1F6B4F" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Archive.Outcome}"
                                                 Value="PassedNotCompared">
                                        <Setter Property="Foreground" Value="#FF7A6A2E" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Archive.Outcome}" Value="Failed">
                                        <Setter Property="Foreground" Value="#FF8A2727" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Margin="0,4,0,0"
                                Visibility="{Binding Archive.IsRunning,
                                    Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Archive.ProgressText}" FontSize="11"
                                   Foreground="#FF5A5A5A" />
                        <ProgressBar Height="8" Width="360" Margin="0,3,0,0"
                                     HorizontalAlignment="Left"
                                     Minimum="0" Maximum="{Binding Archive.ProgressMaximum}"
                                     Value="{Binding Archive.ProgressValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding Archive.IsProgressIndeterminate}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Archive.Lines}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#FF3C3C3C"
                                           TextWrapping="Wrap" Margin="0,1,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Selectable, so the hash can be copied and compared elsewhere. -->
                    <TextBox Text="{Binding Archive.ContentsHashText, Mode=OneWay}" IsReadOnly="True"
                             BorderThickness="0" Background="Transparent" Padding="0"
                             Margin="0,4,0,0" FontFamily="Consolas" FontSize="11"
                             Visibility="{Binding Archive.HasContentsHash,
                                 Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#FFE7E2D9" BorderBrush="#FFCFC8BC"
                BorderThickness="0,1,0,0" Padding="8,5">
            <DockPanel LastChildFill="True">
                <Button Content="◀ Previous" Padding="10,3" Margin="0,0,8,0"
                        DockPanel.Dock="Left" Command="{Binding PreviousCommand}" />

                <Button Content="Next ▶" Padding="10,3" Margin="0,0,16,0"
                        DockPanel.Dock="Left" Command="{Binding NextCommand}" />

                <TextBlock Text="{Binding WorkspaceText}" DockPanel.Dock="Right" FontSize="11"
                           Foreground="#FF5A5A5A" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="16,0,0,0" />

                <TextBlock Text="{Binding RangeText}" VerticalAlignment="Center" FontSize="11"
                           Foreground="#FF3C3C3C" />
            </DockPanel>
        </Border>

        <!-- Status -->
        <Border DockPanel.Dock="Bottom" Padding="8,4" Background="#FFF0EDE7">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Working…" DockPanel.Dock="Right" FontSize="11"
                           Foreground="#FF5A5A5A"
                           Visibility="{Binding IsBusy,
                               Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#FF3C3C3C"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Memories (CH-42 step 4): personal collections and memories in the memories file beside
             the workspace, and the form that adds and edits them. Imported collections are listed
             read-only. Nothing here writes the workspace. -->
        <Border DockPanel.Dock="Right" Width="560" Background="#FFF7F6F3"
                BorderBrush="#FFCFC8BC" BorderThickness="1,0,0,0" Padding="10"
                Visibility="{Binding Memories.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <DockPanel DataContext="{Binding Memories}">
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock Text="Memories" FontWeight="Bold" FontSize="13"
                               DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <Button Content="Close" Padding="8,2" DockPanel.Dock="Right"
                            Command="{Binding CloseCommand}" />
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" FontSize="11"
                           Foreground="#FF3C3C3C" TextWrapping="Wrap" Margin="0,8,0,0" />

                <Grid>
                    <!-- The list. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsListShown,
                                      Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Your collections" FontWeight="SemiBold" />
                            <ListBox ItemsSource="{Binding Collections}"
                                     SelectedItem="{Binding SelectedCollection}"
                                     DisplayMemberPath="DisplayText" Height="110" Margin="0,4,0,0" />

                            <DockPanel Margin="0,6,0,0" LastChildFill="True">
                                <Button Content="Rename" Padding="8,2" Margin="6,0,0,0"
                                        DockPanel.Dock="Right"
                                        Command="{Binding RenameCollectionCommand}"
                                        ToolTip="Rename the selected collection to this name." />
                                <Button Content="Add collection" Padding="8,2" Margin="6,0,0,0"
                                        DockPanel.Dock="Right"
                                        Command="{Binding AddCollectionCommand}" />
                                <TextBox Text="{Binding CollectionName,
                                             UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Text="{Binding CollectionNameError}"
                                       Style="{StaticResource FieldError}" />

                            <TextBlock Text="Memories in this collection" FontWeight="SemiBold"
                                       Margin="0,10,0,0" />
                            <ListBox ItemsSource="{Binding Entries}"
                                     SelectedItem="{Binding SelectedEntry}"
                                     Height="220" Margin="0,4,0,0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock Text="{Binding DateText}" Width="210"
                                                       Foreground="#FF5A5A5A"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding SelectedEntryGalleryText}" FontSize="11"
                                       Foreground="#FF5A5A5A" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Delete collection…" Padding="8,2"
                                        Command="{Binding DeleteCollectionCommand}"
                                        ToolTip="Delete the selected collection; with its memories when it is not empty." />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="New memory…" Padding="8,2"
                                        Command="{Binding NewEntryCommand}" />
                                <Button Content="Edit…" Padding="8,2" Margin="6,0,0,0"
                                        Command="{Binding EditEntryCommand}" />
                                <Button Content="Delete…" Padding="8,2" Margin="6,0,0,0"
                                        Command="{Binding DeleteEntryCommand}" />
                            </StackPanel>

                            <TextBlock Text="Imported collections (read-only)" FontWeight="SemiBold"
                                       Margin="0,12,0,0" />
                            <ItemsControl ItemsSource="{Binding ImportedCollections}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" FontSize="11"
                                                   Foreground="#FF5A5A5A" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Noted dates (CH-47), reduced by CH-53: only while any remain, with edit, delete
                                 and the move to yearly memories; no add. -->
                            <StackPanel Visibility="{Binding HasNotedDates,
                                            Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Noted dates" FontWeight="SemiBold" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding NotedDatesText}" FontSize="11" Foreground="#FF5A5A5A"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                            <ListBox x:Name="NotedDatesList" ItemsSource="{Binding NotedDates}"
                                     SelectedItem="{Binding SelectedNotedDate}"
                                     Height="110" Margin="0,4,0,0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock Text="{Binding DateText}" Width="70"
                                                       Foreground="#FF5A5A5A" />
                                            <TextBlock Text="{Binding GalleryText}" Width="150"
                                                       DockPanel.Dock="Right" Foreground="#FF5A5A5A"
                                                       TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SinceText}" Width="80"
                                                       DockPanel.Dock="Right" Foreground="#FF5A5A5A"
                                                       TextAlignment="Right" />
                                            <TextBlock Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Move noted dates to memories…" Padding="8,2"
                                        Command="{Binding MoveNotedDatesCommand}" />
                                <Button Content="Edit…" Padding="8,2" Margin="6,0,0,0"
                                        Command="{Binding EditNotedDateCommand}" />
                                <Button Content="Delete…" Padding="8,2" Margin="6,0,0,0"
                                        Command="{Binding DeleteNotedDateCommand}" />
                            </StackPanel>
                            </StackPanel>

                            <Button Content="Tidy up images…" Padding="8,2" Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding TidyImagesCommand}"
                                    ToolTip="Lists the images in the memories folder that nothing uses, and deletes them after you confirm." />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- The form. -->
                    <Border Visibility="{Binding IsFormOpen,
                                Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer DataContext="{Binding Form}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />

                                <TextBlock Text="Collection" FontSize="11" Margin="0,8,0,0" />
                                <ComboBox ItemsSource="{Binding Collections}"
                                          SelectedItem="{Binding SelectedCollection}"
                                          DisplayMemberPath="Name" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding CollectionError}"
                                           Style="{StaticResource FieldError}" />

                                <TextBlock Text="Title" FontSize="11" Margin="0,6,0,0" />
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,2,0,0" />
                                <TextBlock Text="{Binding TitleError}" Style="{StaticResource FieldError}" />

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Dated by" FontSize="11" />
                                        <ComboBox ItemsSource="{Binding Precisions}"
                                                  SelectedItem="{Binding Precision}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                        <TextBlock Text="Start" FontSize="11" />
                                        <DatePicker SelectedDate="{Binding StartDate}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding StartError}"
                                                   Style="{StaticResource FieldError}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="End (optional)" FontSize="11" />
                                        <DatePicker SelectedDate="{Binding EndDate}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding EndError}"
                                                   Style="{StaticResource FieldError}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="With Month, only the month of each date is kept."
                                           FontSize="10" Foreground="#FF7A7A7A" Margin="0,2,0,0" />

                                <!-- CH-53: a yearly memory; only for a day without an end date. -->
                                <CheckBox Content="Every year" IsChecked="{Binding EveryYear}"
                                          IsEnabled="{Binding IsEveryYearAvailable}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding EveryYearText}" FontSize="10"
                                           Foreground="#FF7A7A7A" Margin="18,2,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding EveryYearError}" Style="{StaticResource FieldError}" />

                                <TextBlock Text="Description (optional)" FontSize="11" Margin="0,6,0,0" />
                                <TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                                         Margin="0,2,0,0" />
                                <TextBlock Text="{Binding SummaryError}" Style="{StaticResource FieldError}" />

                                <TextBlock Text="Source (where this memory comes from)" FontSize="11"
                                           Margin="0,6,0,0" />
                                <TextBox Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,2,0,0" />
                                <TextBlock Text="{Binding SourceError}" Style="{StaticResource FieldError}" />

                                <TextBlock Text="Photos (optional; the first is the cover)" FontSize="11" Margin="0,8,0,0" />
                                <ItemsControl ItemsSource="{Binding Photos}" Margin="0,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#FFDDD7CC" BorderThickness="1" Padding="6"
                                                    Margin="0,0,0,4">
                                                <DockPanel>
                                                    <Image Source="{Binding Preview}" Width="96" MaxHeight="96"
                                                           Stretch="Uniform" VerticalAlignment="Top"
                                                           Margin="0,0,8,0" DockPanel.Dock="Left" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding RoleText}" FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Text}" FontSize="11"
                                                                   Foreground="#FF5A5A5A" TextWrapping="Wrap" />
                                                        <TextBox Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="0,4,0,0" ToolTip="Caption (optional)"
                                                                 Visibility="{Binding CanEditCaption,
                                                                     Converter={StaticResource BoolToVisibility}}" />
                                                        <WrapPanel Margin="0,4,0,0">
                                                            <Button Content="Up" Padding="6,0" Margin="0,0,4,0"
                                                                    Command="{Binding MoveUpCommand}" />
                                                            <Button Content="Down" Padding="6,0" Margin="0,0,4,0"
                                                                    Command="{Binding MoveDownCommand}" />
                                                            <Button Content="Make cover" Padding="6,0" Margin="0,0,4,0"
                                                                    Command="{Binding MakeCoverCommand}" />
                                                            <Button Content="Remove" Padding="6,0"
                                                                    Command="{Binding RemoveCommand}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="Add photos…" Padding="8,2"
                                            Command="{Binding ChooseImageCommand}"
                                            ToolTip="Choose one or more images. The files are only read; copies go into the memories folder on save." />
                                    <Button Content="Remove all photos" Padding="8,2" Margin="6,0,0,0"
                                            Command="{Binding RemoveImageCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ImageError}" Style="{StaticResource FieldError}" />

                                <TextBlock Text="Links (optional)" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <ContentControl Content="{Binding GalleryLinks}" />

                                <TextBlock Text="Links" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <ItemsControl ItemsSource="{Binding Links}" Margin="0,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2,0,0">
                                                <Button Content="Remove" Padding="6,0" Margin="6,0,0,0"
                                                        DockPanel.Dock="Right"
                                                        Command="{Binding RemoveCommand}" />
                                                <TextBlock Text="{Binding Text}" FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding LinksError}" Style="{StaticResource FieldError}" />

                                <TextBlock Text="Add a link: pick a day" FontSize="11" Margin="0,6,0,0" />
                                <DatePicker SelectedDate="{Binding PickerDate}" Width="160"
                                            HorizontalAlignment="Left" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding PickerText}" FontSize="11"
                                           Foreground="#FF5A5A5A" Margin="0,2,0,0" />

                                <TextBlock Text="Messages of that day" FontSize="11" Margin="0,4,0,0" />
                                <ListBox ItemsSource="{Binding PickerMessages}"
                                         SelectedItem="{Binding SelectedPickerMessage}"
                                         DisplayMemberPath="Text" Height="120" Margin="0,2,0,0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                <Button Content="Link this message" Padding="8,2" Margin="0,4,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding AddMessageLinkCommand}" />

                                <TextBlock Text="Memories of that day" FontSize="11" Margin="0,6,0,0" />
                                <ListBox ItemsSource="{Binding PickerEntries}"
                                         SelectedItem="{Binding SelectedPickerEntry}"
                                         DisplayMemberPath="Text" Height="80" Margin="0,2,0,0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                <Button Content="Link this memory" Padding="8,2" Margin="0,4,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding AddEntryLinkCommand}" />

                                <TextBlock Text="{Binding FormError}" Style="{StaticResource FieldError}"
                                           Margin="0,10,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                    <Button Content="Save" Padding="12,3"
                                            Command="{Binding SaveCommand}" />
                                    <Button Content="Cancel" Padding="12,3" Margin="8,0,0,0"
                                            Command="{Binding CancelCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- The noted-date form (CH-47). -->
                    <Border Visibility="{Binding IsNotedFormOpen,
                                Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer DataContext="{Binding NotedForm}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />

                                <TextBlock Text="Title" FontSize="11" Margin="0,8,0,0" />
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,2,0,0" />
                                <TextBlock Text="{Binding TitleError}" Style="{StaticResource FieldError}" />

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Day" FontSize="11" />
                                        <TextBox Text="{Binding DayText, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Month" FontSize="11" />
                                        <ComboBox ItemsSource="{Binding Months}"
                                                  SelectedItem="{Binding SelectedMonth}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding DateError}" Style="{StaticResource FieldError}" />

                                <TextBlock Text="Year it started (optional)" FontSize="11" Margin="0,6,0,0" />
                                <TextBox Text="{Binding YearText, UpdateSourceTrigger=PropertyChanged}"
                                         Width="100" HorizontalAlignment="Left" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding YearError}" Style="{StaticResource FieldError}" />

                                <TextBlock Text="Note (optional)" FontSize="11" Margin="0,6,0,0" />
                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                                         Margin="0,2,0,0" />
                                <TextBlock Text="{Binding NoteError}" Style="{StaticResource FieldError}" />

                                <TextBlock Text="Links (optional)" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <ContentControl Content="{Binding GalleryLinks}" />

                                <TextBlock Text="{Binding FormError}" Style="{StaticResource FieldError}"
                                           Margin="0,10,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                    <Button Content="Save" Padding="12,3"
                                            Command="{Binding SaveCommand}" />
                                    <Button Content="Cancel" Padding="12,3" Margin="8,0,0,0"
                                            Command="{Binding CancelCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Review panel.

             Docked right, before the conversation's fill child, so the message list keeps its own
             templated ScrollViewer and its virtualisation untouched and simply narrows. The
             candidate list carries the same arrangement for the same reason. -->
        <Border DockPanel.Dock="Right" Width="380" Background="#FFF7F6F3"
                BorderBrush="#FFCFC8BC" BorderThickness="1,0,0,0" Padding="10"
                Visibility="{Binding Review.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock Text="Review media" FontWeight="Bold" FontSize="13"
                               DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <Button Content="Close" Padding="8,2" DockPanel.Dock="Right"
                            Click="CloseReviewClick" />
                </DockPanel>

                <TextBlock DockPanel.Dock="Top" Text="{Binding Review.HeadlineText}"
                           FontWeight="SemiBold" TextWrapping="Wrap" />

                <TextBlock DockPanel.Dock="Top" Text="{Binding Review.EvidenceText}"
                           Margin="0,2,0,8" FontSize="11" Foreground="#FF5A5A5A"
                           TextWrapping="Wrap" />

                <!-- Armed decision: the consequence is stated before the action that writes it
                     exists. Nothing writes on selection, on opening media, or on navigation. -->
                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8" CornerRadius="4"
                        BorderBrush="#FFC9A227" BorderThickness="1" Background="#FFFBF3D8"
                        Visibility="{Binding Review.HasPendingDecision,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Review.PendingWarningText}" TextWrapping="Wrap"
                                   FontSize="11" />

                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding Review.NeedsBasis,
                                        Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Independent basis type" FontSize="11" />
                            <ComboBox ItemsSource="{Binding Review.BasisTypes}"
                                      SelectedItem="{Binding Review.BasisType}" Margin="0,2,0,4" />
                            <TextBlock Text="What independently establishes this identity?"
                                       FontSize="11" />
                            <TextBox Text="{Binding Review.BasisDescription,
                                         UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="56"
                                     Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding Review.NeedsDisproofReason,
                                        Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Why is this candidate ruled out?" FontSize="11" />
                            <TextBox Text="{Binding Review.DisproofReason,
                                         UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="48"
                                     Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding Review.NeedsRevocationReason,
                                        Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Why is this resolution being revoked?" FontSize="11" />
                            <TextBox Text="{Binding Review.RevocationReason,
                                         UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="48"
                                     Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding Review.NeedsReviewNotes,
                                        Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Notes (optional)" FontSize="11" />
                            <TextBox Text="{Binding Review.ReviewNotes,
                                         UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="48"
                                     Margin="0,2,0,0" />
                        </StackPanel>

                        <DockPanel Margin="0,8,0,0" LastChildFill="False">
                            <Button Content="Record decision" Padding="10,3" DockPanel.Dock="Left"
                                    Command="{Binding Review.CommitCommand}" />
                            <Button Content="Cancel" Padding="10,3" Margin="8,0,0,0"
                                    DockPanel.Dock="Left"
                                    Command="{Binding Review.CancelPendingCommand}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Actions. Each arms a decision; none of them writes. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text="{Binding Review.StatusText}" FontSize="11"
                               Foreground="#FF3C3C3C" TextWrapping="Wrap" Margin="0,0,0,6" />

                    <Button Content="Reviewed — insufficient evidence" Padding="8,3"
                            Margin="0,0,0,4" HorizontalAlignment="Stretch"
                            Command="{Binding Review.BeginReviewCommand}" />
                    <Button Content="Mark candidate independently disproven…" Padding="8,3"
                            Margin="0,0,0,4" HorizontalAlignment="Stretch"
                            Command="{Binding Review.BeginDisproveCommand}" />
                    <Button Content="Confirm as this media…" Padding="8,3" Margin="0,0,0,4"
                            HorizontalAlignment="Stretch"
                            Command="{Binding Review.BeginConfirmCommand}" />
                    <Button Content="Replace resolution…" Padding="8,3" Margin="0,0,0,4"
                            HorizontalAlignment="Stretch"
                            Command="{Binding Review.BeginReplaceCommand}" />
                    <Button Content="Revoke resolution…" Padding="8,3"
                            HorizontalAlignment="Stretch"
                            Command="{Binding Review.BeginRevokeCommand}" />
                </StackPanel>

                <!-- Candidates and history share the panel's remaining height. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Pixel scrolling for the same reason as the conversation (CH-7): a
                         candidate card with its preview can be taller than the space this list
                         is left with, and item scrolling would never show the rest of it. -->
                    <ListBox x:Name="CandidateList" Grid.Row="0"
                             ItemsSource="{Binding Review.Candidates}"
                             SelectedItem="{Binding Review.SelectedCandidate}"
                             ItemTemplate="{StaticResource CandidateTemplate}"
                             HorizontalContentAlignment="Stretch"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" />

                    <StackPanel Grid.Row="1" Margin="0,8,0,0"
                                Visibility="{Binding Review.HasHistory,
                                    Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Resolution history" FontWeight="SemiBold" FontSize="11"
                                   Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Review.History}"
                                      ItemTemplate="{StaticResource HistoryTemplate}" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Memory details (CH-42 step 5): what the selected memory row holds, with the phone's
             headings. Docked right like the review panel, and independent of it: opening it selects
             no message and changes no review. A message link moves the conversation; Edit opens a
             personal memory in the Memories area's form. -->
        <Border DockPanel.Dock="Right" Width="360" Background="#FFF7F6F3"
                BorderBrush="#FFCFC8BC" BorderThickness="1,0,0,0" Padding="10"
                Visibility="{Binding IsMemoryDetailsOpen, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock Text="{Binding MemoryDetails.CollectionName, FallbackValue=''}" FontWeight="Bold"
                               FontSize="13" DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <Button Content="Close" Padding="8,2" DockPanel.Dock="Right"
                            Command="{Binding CloseMemoryDetailsCommand}" />
                    <Button Content="Edit…" Padding="8,2" Margin="0,0,6,0" DockPanel.Dock="Right"
                            Command="{Binding EditMemoryCommand}"
                            Visibility="{Binding MemoryDetails.IsPersonal, FallbackValue=Collapsed,
                                Converter={StaticResource BoolToVisibility}}" />
                </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MemoryDetailsBody" DataContext="{Binding MemoryDetails}">
                        <Image Source="{Binding Image}" MaxHeight="200" Stretch="Uniform"
                               HorizontalAlignment="Left" Margin="0,0,0,6" Cursor="Hand"
                               ToolTip="Show the photo large"
                               MouseLeftButtonUp="MemoryPhotoClick"
                               Visibility="{Binding ShowsSingleImage, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Every photo of the memory, the cover first, with captions (CH-46). A click
                             shows it large, moving through this memory's photos only. -->
                        <ItemsControl x:Name="MemoryPhotoStrip" ItemsSource="{Binding Photos}" Margin="0,0,0,6"
                                      Visibility="{Binding HasPhotoStrip, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="104" Margin="0,0,6,6" Cursor="Hand"
                                                ToolTip="Show the photo large"
                                                MouseLeftButtonUp="MemoryPhotoClick">
                                        <Image Source="{Binding Thumbnail}" Height="80" Stretch="Uniform" />
                                        <TextBlock Text="{Binding Caption}" FontSize="10" TextWrapping="Wrap"
                                                   MaxHeight="40" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasCaption, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="#FF6A6A6A" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Summary}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Lines}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ItemsHeading}" FontWeight="SemiBold" Margin="0,10,0,2" />
                            <ItemsControl ItemsSource="{Binding Items}"
                                          ItemTemplate="{StaticResource MemoryItemTemplate}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasDayEvidence, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding DayHeading}" FontWeight="SemiBold" Margin="0,10,0,2" />
                            <TextBlock Text="{Binding DayEvidenceText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasOtherPeriods, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding OtherPeriodsHeading}" FontSize="11" Foreground="#FF6A6A6A"
                                       Margin="0,6,0,2" />
                            <ItemsControl ItemsSource="{Binding OtherPeriods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasLinks, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding LinksHeading}" FontWeight="SemiBold" Margin="0,10,0,2" />
                            <ItemsControl ItemsSource="{Binding Links}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2" TextWrapping="Wrap">
                                            <Hyperlink Click="MemoryLinkClick">
                                                <Run Text="{Binding Text, Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="{Binding SourceLine}" FontSize="11" Foreground="#FF6A6A6A"
                                   Margin="0,10,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Conversation.

             The ItemsControl carries its own ScrollViewer with CanContentScroll set, so its
             VirtualizingStackPanel actually virtualises. Putting the list inside an outer
             ScrollViewer would give it infinite height and silently realise every item.

             ScrollUnit is Pixel, and must stay so (CH-7). The default, Item, makes every scroll
             offset the top of some message: the wheel moves three whole messages a notch, and a
             line moves one. With bubbles as tall as photo messages, that skips past photos that
             were never wholly on screen, and the part of a message taller than the window below
             its first screenful can never be shown at all. Pixel scrolling keeps the panel's
             container virtualisation; only the unit of the offset changes.

             Moving to another page or date starts the new page at its top (CH-12); the window
             does that when the view-model raises MovedToPage. The review panel opening and
             closing does not move the list. -->
        <DockPanel>
            <!-- Conversation header: the title, and the memory layers (CH-42 step 5) when the memories
                 file beside the workspace has any. Switches and filters are remembered per workspace,
                 never in the workspace or the memories file. -->
            <DockPanel DockPanel.Dock="Top" Margin="12,8" LastChildFill="True">
                <Grid DockPanel.Dock="Right"
                      Visibility="{Binding HasLayers, Converter={StaticResource BoolToVisibility}}">
                    <ToggleButton x:Name="LayersButton" Content="Layers" Padding="10,2"
                                  IsChecked="{Binding IsLayersOpen}"
                                  ToolTip="Memory layers shown among the messages" />
                    <Popup x:Name="LayersPopup" IsOpen="{Binding IsLayersOpen}"
                           PlacementTarget="{Binding ElementName=LayersButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="#FFF7F6F3" BorderBrush="#FFCFC8BC" BorderThickness="1"
                                Padding="10" MinWidth="240" MaxWidth="360">
                            <StackPanel>
                                <TextBlock Text="Memory layers" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Layers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MemoryLayerViewModel}">
                                            <StackPanel Margin="0,2,0,4">
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsShown}" />
                                                <ItemsControl ItemsSource="{Binding Filters}" Margin="20,2,0,0"
                                                              IsEnabled="{Binding IsShown}"
                                                              Visibility="{Binding HasFilters,
                                                                  Converter={StaticResource BoolToVisibility}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:MemoryFilterViewModel}">
                                                            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsOn}"
                                                                      FontSize="11" Margin="0,1" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding LayersNote}" FontSize="11" Foreground="#FF5A5A5A"
                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding HasLayersNote,
                                               Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <TextBlock Text="{Binding ConversationTitle}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <ItemsControl x:Name="MessageList" ItemsSource="{Binding Rows}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="MessageScroller" CanContentScroll="True" Padding="4"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DockPanel>
    </DockPanel>

        <!-- The large view of a memory's photo (CH-46): over the whole window, moving through that
             memory's photos only. Memory photos are not in the Photos gallery. -->
        <Grid x:Name="MemoryPhotoViewer" Background="#F0101010"
              Visibility="{Binding IsMemoryPhotoViewerOpen, Converter={StaticResource BoolToVisibility}}">
            <DockPanel DataContext="{Binding MemoryPhotoViewer}" Margin="16">
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold"
                               DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <Button Content="Close" Padding="10,2" DockPanel.Dock="Right"
                            Command="{Binding CloseCommand}" />
                    <Button Content="Next" Padding="10,2" Margin="0,0,6,0" DockPanel.Dock="Right"
                            Command="{Binding NextCommand}" />
                    <Button Content="Previous" Padding="10,2" Margin="0,0,6,0" DockPanel.Dock="Right"
                            Command="{Binding PreviousCommand}" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Caption}" Foreground="White" FontSize="13"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                           Visibility="{Binding HasCaption, Converter={StaticResource BoolToVisibility}}" />
                <Grid>
                    <Image Source="{Binding Image}" Stretch="Uniform" StretchDirection="DownOnly" />
                    <TextBlock Text="This photo could not be shown." Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding CannotShow, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>

