<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Android only: no iOS, Mac or Windows heads. -->
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Chatcheology.Android</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>Chatcheology</ApplicationTitle>

    <!-- Provisional; CH-27 confirms the permanent identifier before anything is published. -->
    <ApplicationId>org.chatcheology.viewer</ApplicationId>

    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Android 8.0 (API 26) and later. The target is the newest platform the SDK builds for
         (android-36 for net10.0-android). -->
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>

    <!-- Phones (arm64) and the x86-64 emulator. 32-bit ABIs are left out: no current phone needs
         them and they would double the native libraries in the package. -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- A sideloadable APK for now; the Play Store later takes an AAB from the same project. -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <!-- Release signing. Nothing secret is in this repository: the settings come from environment
       variables or from a file outside it, and without them the build still succeeds with the
       SDK's debug key. Property names: README.md beside this file. -->
  <Import Project="$(USERPROFILE)\.chatcheology\signing.props"
          Condition="'$(USERPROFILE)' != '' And Exists('$(USERPROFILE)\.chatcheology\signing.props')" />

  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(CHATCHEOLOGY_KEYSTORE)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(CHATCHEOLOGY_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(CHATCHEOLOGY_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>$(CHATCHEOLOGY_STORE_PASS)</AndroidSigningStorePass>
    <AndroidSigningKeyPass>$(CHATCHEOLOGY_KEY_PASS)</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2E6B5E" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2E6B5E" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chatcheology.Mobile\Chatcheology.Mobile.csproj" />
  </ItemGroup>

  <!-- Debug only: the synthetic archive generator, so a development build can install an invented
       archive without an import. A Release build does not contain it. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <Compile Include="..\Chatcheology.Mobile.Tests\Synthetic\*.cs" Link="Debug\Synthetic\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
