<?xml version="1.0" encoding="utf-8" ?>
<!-- The start screen: the installed archives, or a note that there are none yet. Import comes in a
     later step; Debug builds add tools for installing a synthetic archive and for the trial. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chatcheology.Android.Pages.StartPage"
             Title="Chatcheology">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label x:Name="Summary" FontSize="16" />
            <VerticalStackLayout x:Name="Archives" Spacing="8" />
            <VerticalStackLayout x:Name="DevelopmentTools" Spacing="8" />
            <Label x:Name="Status" FontSize="14" TextColor="{StaticResource MutedText}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
