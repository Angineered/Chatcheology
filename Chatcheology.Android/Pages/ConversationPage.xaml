<?xml version="1.0" encoding="utf-8" ?>
<!-- The conversation in MAUI's CollectionView (chosen by the CH-26 trial). Rows are separators and
     messages; a selector picks the template. Image heights come from the recorded size, so a row has
     its final height before its image is decoded. Hidden low-quality copies are not drawn. Message
     text with addresses is drawn by MessageText, whose links open only on a tap. A message opened from
     search is highlighted through its own IsHighlighted flag, so the highlight follows the message, not
     a recycled view. A long press on a bubble offers Share for text and Star / Unstar (MessageBubble,
     MessageText, AttachmentCardView); a starred message, or one with a starred photo, shows a small
     star beside its time (CH-38). Colours come in light and dark pairs (CH-41). Memory rows (CH-42)
     are centred lavender cards (a PSN period, a personal memory) or a muted italic line ("different
     times"), never bubbles; a tap opens their details, and they have no long press. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Chatcheology.Mobile.Conversation;assembly=Chatcheology.Mobile"
             xmlns:pages="clr-namespace:Chatcheology.Android.Pages"
             xmlns:controls="clr-namespace:Chatcheology.Android.Controls"
             x:Class="Chatcheology.Android.Pages.ConversationPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource ChatBackgroundLight}, Dark={StaticResource ChatBackgroundDark}}">

    <ContentPage.Resources>
        <DataTemplate x:Key="Separator" x:DataType="conv:DateSeparatorRow">
            <Grid Padding="0,8">
                <!-- CH-54: a long press offers "Add a memory on this day". -->
                <controls:DaySeparator HorizontalOptions="Center" BackgroundColor="{AppThemeBinding Light={StaticResource SeparatorBackgroundLight}, Dark={StaticResource SeparatorBackgroundDark}}"
                        StrokeThickness="0" Padding="10,4" StrokeShape="RoundRectangle 8">
                    <Label Text="{Binding Text}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                </controls:DaySeparator>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Theirs" x:DataType="conv:MessageRow">
            <Grid Padding="8,2,56,2">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsHighlighted}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HighlightLight}, Dark={StaticResource HighlightDark}}" />
                    </DataTrigger>
                </Grid.Triggers>
                <controls:MessageBubble HorizontalOptions="Start" BackgroundColor="{AppThemeBinding Light={StaticResource BubbleTheirsLight}, Dark={StaticResource BubbleTheirsDark}}"
                                        StrokeThickness="0" Padding="8,6" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding SenderText}" FontSize="13" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource SenderTextLight}, Dark={StaticResource SenderTextDark}}" />
                        <Label Text="{Binding ForwardedText}" IsVisible="{Binding IsForwarded}" FontSize="12"
                               FontAttributes="Italic" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding ShownAttachments}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="conv:AttachmentCard">
                                    <controls:AttachmentCardView />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <controls:MessageText />
                        <HorizontalStackLayout HorizontalOptions="End" Spacing="4">
                            <Label Text="★" FontSize="11" IsVisible="{Binding ShowsStar}"
                                   TextColor="{AppThemeBinding Light={StaticResource StarLight}, Dark={StaticResource StarDark}}" />
                            <Label Text="{Binding TimeText}" FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </controls:MessageBubble>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Mine" x:DataType="conv:MessageRow">
            <Grid Padding="56,2,8,2">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsHighlighted}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HighlightLight}, Dark={StaticResource HighlightDark}}" />
                    </DataTrigger>
                </Grid.Triggers>
                <controls:MessageBubble HorizontalOptions="End" BackgroundColor="{AppThemeBinding Light={StaticResource BubbleMineLight}, Dark={StaticResource BubbleMineDark}}"
                                        StrokeThickness="0" Padding="8,6" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding ForwardedText}" IsVisible="{Binding IsForwarded}" FontSize="12"
                               FontAttributes="Italic" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding ShownAttachments}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="conv:AttachmentCard">
                                    <controls:AttachmentCardView />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <controls:MessageText />
                        <HorizontalStackLayout HorizontalOptions="End" Spacing="4">
                            <Label Text="★" FontSize="11" IsVisible="{Binding ShowsStar}"
                                   TextColor="{AppThemeBinding Light={StaticResource StarLight}, Dark={StaticResource StarDark}}" />
                            <Label Text="{Binding TimeText}" FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </controls:MessageBubble>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="System" x:DataType="conv:MessageRow">
            <Grid Padding="32,4">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsHighlighted}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HighlightLight}, Dark={StaticResource HighlightDark}}" />
                    </DataTrigger>
                </Grid.Triggers>
                <Border HorizontalOptions="Center" BackgroundColor="{AppThemeBinding Light={StaticResource BubbleSystemLight}, Dark={StaticResource BubbleSystemDark}}"
                        StrokeThickness="0" Padding="10,4" StrokeShape="RoundRectangle 8">
                    <Label Text="{Binding Text}" FontSize="12" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PeriodCard" x:DataType="conv:PeriodCardRow">
            <Grid Padding="28,6">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsHighlighted}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HighlightLight}, Dark={StaticResource HighlightDark}}" />
                    </DataTrigger>
                </Grid.Triggers>
                <controls:MemoryCard HorizontalOptions="Center" MaximumWidthRequest="380" Padding="10,8" StrokeThickness="1"
                                     StrokeShape="RoundRectangle 12"
                                     Stroke="{AppThemeBinding Light={StaticResource MemoryAccentLight}, Dark={StaticResource MemoryAccentDark}}"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource MemoryCardBackgroundLight}, Dark={StaticResource MemoryCardBackgroundDark}}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:DecodedImage WidthRequest="56" HeightRequest="56" VerticalOptions="Start" FailedText=""
                                               IsVisible="{Binding HasImage}" Path="{Binding ImagePath}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" />
                            <Label Text="{Binding DateText}" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                            <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding ParticipantLines}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Label Text="{Binding .}" FontSize="13" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="{Binding LabelText}" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource MemoryAccentLight}, Dark={StaticResource MemoryAccentDark}}" />
                            <Label Text="{Binding SourceText}" IsVisible="{Binding HasSource}" FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                </controls:MemoryCard>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DifferentTimes" x:DataType="conv:DifferentTimesRow">
            <Grid Padding="40,4">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsHighlighted}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HighlightLight}, Dark={StaticResource HighlightDark}}" />
                    </DataTrigger>
                </Grid.Triggers>
                <controls:MemoryCard HorizontalOptions="Center" StrokeThickness="0" Padding="8,2" BackgroundColor="Transparent">
                    <Label Text="{Binding Text}" FontSize="12" FontAttributes="Italic" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                </controls:MemoryCard>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EntryCard" x:DataType="conv:EntryCardRow">
            <Grid Padding="28,6">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsHighlighted}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HighlightLight}, Dark={StaticResource HighlightDark}}" />
                    </DataTrigger>
                </Grid.Triggers>
                <controls:MemoryCard HorizontalOptions="Center" WidthRequest="280" Padding="0,0,0,8" StrokeThickness="1"
                                     StrokeShape="RoundRectangle 12"
                                     Stroke="{AppThemeBinding Light={StaticResource MemoryAccentLight}, Dark={StaticResource MemoryAccentDark}}"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource MemoryCardBackgroundLight}, Dark={StaticResource MemoryCardBackgroundDark}}">
                    <VerticalStackLayout Spacing="2">
                        <Grid IsVisible="{Binding HasImage}">
                            <controls:DecodedImage WidthRequest="280" HeightRequest="158" FailedText=""
                                                   Path="{Binding ImagePath}" />
                            <!-- "+4": the memory's extra photos after the cover (CH-46). -->
                            <Border IsVisible="{Binding HasExtraPhotos}" HorizontalOptions="End" VerticalOptions="End"
                                    Margin="6" Padding="7,1" StrokeThickness="0" StrokeShape="RoundRectangle 9"
                                    BackgroundColor="#CC000000">
                                <Label Text="{Binding ExtraPhotosBadge}" FontSize="12" FontAttributes="Bold" TextColor="White" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding CollectionName}" FontSize="11" Margin="10,6,10,0"
                               TextColor="{AppThemeBinding Light={StaticResource MemoryAccentLight}, Dark={StaticResource MemoryAccentDark}}" />
                        <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" Margin="10,0" />
                        <Label Text="{Binding DateText}" FontSize="12" Margin="10,0"
                               TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                        <Label Text="{Binding Summary}" IsVisible="{Binding HasSummary}" FontSize="13" Margin="10,2,10,0" MaxLines="4"
                               LineBreakMode="TailTruncation" />
                        <!-- CH-48: "Link · host" or "N links"; the links themselves open from the details. -->
                        <Label Text="{Binding GalleryText}" IsVisible="{Binding HasGalleries}" FontSize="12" Margin="10,2,10,0"
                               TextColor="{AppThemeBinding Light={StaticResource MemoryAccentLight}, Dark={StaticResource MemoryAccentDark}}" />
                        <Label Text="{Binding SourceText}" IsVisible="{Binding HasSource}" FontSize="11" Margin="10,0"
                               TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    </VerticalStackLayout>
                </controls:MemoryCard>
            </Grid>
        </DataTemplate>

        <pages:RowTemplateSelector x:Key="RowTemplates"
                                   Separator="{StaticResource Separator}"
                                   Theirs="{StaticResource Theirs}"
                                   Mine="{StaticResource Mine}"
                                   System="{StaticResource System}"
                                   PeriodCard="{StaticResource PeriodCard}"
                                   DifferentTimes="{StaticResource DifferentTimes}"
                                   EntryCard="{StaticResource EntryCard}" />
    </ContentPage.Resources>

    <Grid>
        <CollectionView x:Name="List"
                        ItemTemplate="{StaticResource RowTemplates}"
                        SelectionMode="None" />
        <ActivityIndicator x:Name="Busy" IsVisible="False" IsRunning="False"
                           HorizontalOptions="Center" VerticalOptions="Center" />

        <!-- On this day (CH-39): earlier years with messages today, each a jump; filled in code. -->
        <Border x:Name="OnThisDayCard" IsVisible="False" VerticalOptions="Start" Margin="12,8"
                Padding="14,8,6,8" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                BackgroundColor="{AppThemeBinding Light={StaticResource SeparatorBackgroundLight}, Dark={StaticResource SeparatorBackgroundDark}}">
            <Border.Shadow>
                <Shadow Radius="6" Opacity="0.25" Offset="0,2" Brush="Black" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <VerticalStackLayout Spacing="2">
                    <!-- CH-53: today's yearly memories first, one row each with its cover thumbnail and gallery chip. -->
                    <VerticalStackLayout x:Name="OnThisDayYearly" Spacing="0" />
                    <!-- CH-47: today's noted dates, one row each, before the message years. -->
                    <VerticalStackLayout x:Name="OnThisDayNoted" Spacing="0" />
                    <VerticalStackLayout x:Name="OnThisDayYears" Spacing="0" />
                </VerticalStackLayout>
                <Label x:Name="OnThisDayClose" Grid.Column="1" Text="✕" FontSize="16" Padding="10,4"
                       VerticalOptions="Center" SemanticProperties.Description="Dismiss until tomorrow"
                       TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
            </Grid>
        </Border>

        <!-- The floating date (CH-65): the top row's day in the separators' look and wording, shown only while
             the reader scrolls and faded out after the list rests. Never takes a touch; sits just below the
             On this day card while that is open (moved with TranslationY, no layout per scroll). -->
        <Border x:Name="FloatingDatePill" IsVisible="False" Opacity="0" InputTransparent="True"
                HorizontalOptions="Center" VerticalOptions="Start" Margin="0,8,0,0"
                Padding="10,4" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                BackgroundColor="{AppThemeBinding Light={StaticResource SeparatorBackgroundLight}, Dark={StaticResource SeparatorBackgroundDark}}">
            <Border.Shadow>
                <Shadow Radius="4" Opacity="0.2" Offset="0,1" Brush="Black" />
            </Border.Shadow>
            <Label x:Name="FloatingDateText" FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
        </Border>
    </Grid>
</ContentPage>
