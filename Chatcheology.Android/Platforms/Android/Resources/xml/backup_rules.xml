<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier (android:fullBackupContent): exclude everything. The archive copies,
     settings and last positions stay on this phone only. -->
<full-backup-content>
	<exclude domain="root" path="." />
	<exclude domain="file" path="." />
	<exclude domain="database" path="." />
	<exclude domain="sharedpref" path="." />
	<exclude domain="external" path="." />
</full-backup-content>
