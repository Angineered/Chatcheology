<Project Sdk="Microsoft.NET.Sdk">

  <!-- Operator tool for the WhatsApp msgstore route (CH-2 onward; promoted from .temp in CH-71).

       It turns msgstore matches into Phase 7 confirmations through the public Phase 7 services only,
       and records msgstore facts (forwarded status, low-quality copies, text facts, captions) through
       the Data writers. No ranking or scoring. Built and tested on synthetic data only; the operator
       runs it on real data, and every real path, chat id and participant id is a command-line value. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MsgstoreImport</AssemblyName>
    <RootNamespace>MsgstoreImport</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MsgstoreImport.Tests" />
    <!-- CH-71 step 5: the archive refresh runs the newer-messages and caption-facts steps in process. -->
    <InternalsVisibleTo Include="ArchiveRefresh" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Chatcheology.Core\Chatcheology.Core.csproj" />
    <ProjectReference Include="..\..\Chatcheology.Data\Chatcheology.Data.csproj" />
  </ItemGroup>

</Project>
