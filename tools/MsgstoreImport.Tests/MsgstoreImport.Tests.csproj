<Project Sdk="Microsoft.NET.Sdk">

  <!-- Synthetic-data tests for the msgstore import tool. Everything is invented: no real data,
       identifiers, paths or counts. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MsgstoreImport\MsgstoreImport.csproj" />
    <ProjectReference Include="..\..\Chatcheology.Core\Chatcheology.Core.csproj" />
    <ProjectReference Include="..\..\Chatcheology.Data\Chatcheology.Data.csproj" />
    <!-- CH-71 step 3b: the phone must recognise exactly the placeholder wordings the import writes. -->
    <ProjectReference Include="..\..\Chatcheology.Mobile\Chatcheology.Mobile.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
