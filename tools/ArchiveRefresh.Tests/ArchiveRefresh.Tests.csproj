<Project Sdk="Microsoft.NET.Sdk">

  <!-- Synthetic-data tests for the archive refresh tool. Everything is invented: no real data, identifiers,
       paths or counts. The synthetic builders are shared with the tools' own tests. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- As the tool: the PSN code needs the IANA time zone, so not invariant. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArchiveRefresh\ArchiveRefresh.csproj" />
    <ProjectReference Include="..\..\Chatcheology.Core\Chatcheology.Core.csproj" />
    <ProjectReference Include="..\..\Chatcheology.Data\Chatcheology.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\MsgstoreImport.Tests\SyntheticData.cs" Link="Shared\SyntheticData.cs" />
    <Compile Include="..\MemoryImport.Tests\SyntheticTrophyBatch.cs" Link="Shared\SyntheticTrophyBatch.cs" />
    <Compile Include="..\..\Chatcheology.Data.Tests\Memories\SyntheticTrophyDefinitions.cs" Link="Shared\SyntheticTrophyDefinitions.cs" />
    <Compile Include="..\..\Chatcheology.Data.Tests\Memories\SyntheticPsnFile.cs" Link="Shared\SyntheticPsnFile.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
